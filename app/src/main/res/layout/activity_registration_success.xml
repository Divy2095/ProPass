<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/successRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".RegistrationSuccessActivity">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/successScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/successContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Spacer for Top Bar -->
            <View
                android:id="@+id/topBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="64dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- Success Icon Badge -->
            <FrameLayout
                android:id="@+id/badgeSuccessContainer"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_success_circle_badge">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_verified"
                    app:tint="#4CAF50" />
            </FrameLayout>

            <!-- Success Title -->
            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="@string/success_title"
                android:textColor="@color/on_surface"
                android:textSize="28sp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/success_registered_for"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />

            <!-- Event Card Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_container_low"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardPreventCornerOverlap="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvSuccessEventTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/primary"
                        android:textSize="22sp"
                        tools:text="TechConf 2024" />

                    <TextView
                        android:id="@+id/tvSuccessAttendeeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        tools:text="Alex Morgan • General Attendee" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="32dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineHeight="20sp"
                android:text="@string/success_description"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                tools:targetApi="p" />

            <!-- Spacer -->
            <View
                android:id="@+id/bottomBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="140dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_translucent_bar"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/cd_app_icon"
                android:src="@drawable/ic_propass_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="@string/app_name"
                android:textColor="@color/on_surface"
                android:textSize="18sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Sticky Bottom Actions -->
    <LinearLayout
        android:id="@+id/stickyBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_translucent_bar"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Primary: View My Pass -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewMyPass"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/btn_view_my_pass"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_badge"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/on_primary" />

        <!-- Secondary: Go Home -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoHome"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/btn_go_home"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp" />

    </LinearLayout>

</FrameLayout>
