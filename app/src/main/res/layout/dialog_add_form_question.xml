<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Question Label Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilQuestionLabel"
            style="@style/Widget.ProPass.TextInputLayout.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/label_question_text"
            app:errorEnabled="true"
            app:errorTextColor="@color/error"
            app:hintTextColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuestionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:inputType="textCapSentences"
                android:textColor="@color/on_surface"
                android:textColorHighlight="@color/secondary_container"
                android:textColorHint="@color/on_surface_variant"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Question Type Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.05"
            android:text="@string/label_question_type"
            android:textAllCaps="true"
            android:textColor="@color/secondary"
            android:textSize="11sp" />

        <RadioGroup
            android:id="@+id/rgQuestionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbShortText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/inter_regular"
                android:text="Short Text (Single line)"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbLongText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Long Text (Multi-line paragraph)"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbMultipleChoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Multiple Choice (Select one option)"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="Checkbox (Multi-select options)"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- Options Input (Only visible for Multiple Choice or Checkbox) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilQuestionOptions"
            style="@style/Widget.ProPass.TextInputLayout.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/label_question_options"
            android:visibility="gone"
            app:errorEnabled="true"
            app:errorTextColor="@color/error"
            app:helperText="Separate multiple choices with commas"
            app:helperTextTextColor="@color/on_surface_variant"
            app:helperTextEnabled="true"
            app:hintTextColor="@color/primary"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuestionOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:inputType="textCapWords"
                android:textColor="@color/on_surface"
                android:textColorHighlight="@color/secondary_container"
                android:textColorHint="@color/on_surface_variant"
                android:textCursorDrawable="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Required Switch / Checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbIsRequired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:text="@string/label_question_required"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
