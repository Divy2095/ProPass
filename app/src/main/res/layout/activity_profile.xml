<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ProfileActivity">

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/profileContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dynamic Top Spacer for Status Bar & Header (64dp + Insets) -->
            <View
                android:id="@+id/topBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="64dp" />

            <!-- 1. Profile Hero Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <!-- Avatar Circle with Verified Badge -->
                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:id="@+id/avatarContainer"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_avatar_circle">

                        <ImageView
                            android:id="@+id/ivAvatarIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_person"
                            app:tint="@color/outline" />
                    </FrameLayout>

                    <!-- Verified Checkmark Badge -->
                    <ImageView
                        android:id="@+id/badgeVerified"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="@string/cd_verified_badge"
                        android:src="@drawable/ic_verified"
                        android:visibility="gone"
                        app:tint="@color/primary"
                        tools:visibility="visible" />
                </FrameLayout>

                <!-- Full Name -->
                <TextView
                    android:id="@+id/tvProfileFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:textAlignment="center"
                    android:textColor="@color/on_surface"
                    android:textSize="22sp"
                    tools:text="Alex Morgan" />

                <!-- Professional Headline (Title · Org) -->
                <TextView
                    android:id="@+id/tvProfileHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:textAlignment="center"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp"
                    tools:text="Senior Software Engineer • TechFlow Inc." />

                <!-- Email -->
                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:textAlignment="center"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp"
                    tools:text="alex.morgan@example.com" />

            </LinearLayout>

            <!-- 2. Profile Completion Card (Matches Home Dashboard Design) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfileCompletion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_container"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <!-- Left Text Content -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/profile_complete_title"
                                android:textColor="@color/on_surface"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/tvCompletionSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="@font/inter_regular"
                                android:includeFontPadding="false"
                                android:text="@string/profile_complete_subtitle"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvMissingFieldsHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:fontFamily="@font/inter_medium"
                                android:includeFontPadding="false"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:text="Incomplete: LinkedIn, Avatar"
                                tools:visibility="visible" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditProfileCompletion"
                                style="@style/Widget.ProPass.Button.PillPrimary"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="16dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="6dp"
                                android:text="@string/btn_add_details"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Right Progress Ring (80dp x 80dp) -->
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp">

                            <com.mpc.propass.CircularProgressView
                                android:id="@+id/progressCircle"
                                android:layout_width="80dp"
                                android:layout_height="80dp" />

                            <TextView
                                android:id="@+id/tvProgressPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:text="0%"
                                android:textColor="@color/on_surface"
                                android:textSize="20sp"
                                tools:text="85%" />
                        </FrameLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <!-- 3. Profile Information Details Card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfileDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_container"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/profile_section_personal"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp" />

                        <!-- Full Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_full_name"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDetailFullName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            tools:text="Alex Morgan" />

                        <!-- Email -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/hint_email"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDetailEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            tools:text="alex.morgan@example.com" />

                        <!-- Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_title"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDetailTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            tools:text="Senior Software Engineer" />

                        <!-- Organization -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_organization"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDetailOrg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            tools:text="TechFlow Inc." />

                        <!-- Phone -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_phone"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDetailPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            tools:text="+1 (555) 012-3456" />

                        <!-- LinkedIn -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_linkedin"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDetailLinkedin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            tools:text="https://linkedin.com/in/alexmorgan" />

                        <!-- Avatar URL -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/label_avatar_url"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDetailAvatar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            tools:text="https://example.com/photo.jpg" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <!-- 4. Action Buttons (Edit Profile & Logout) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    style="@style/Widget.ProPass.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/profile_edit_btn"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOrganizerPortal"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/surface_container_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/organizer_switch_to_organizer"
                    android:textColor="@color/primary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_business"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/btn_logout"
                    android:textColor="@color/error"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/error" />

            </LinearLayout>

            <!-- Bottom Spacer for Floating Bottom Nav (88dp + Insets) -->
            <View
                android:id="@+id/bottomBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="88dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Translucent Fixed Top App Bar -->
    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_translucent_bar"
        android:elevation="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_propass_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:text="@string/profile_screen_title"
                android:textColor="@color/on_surface"
                android:textSize="20sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Fixed Bottom Navigation Bar with Profile Active -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_translucent_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:orientation="vertical">

        <!-- 4-Tab Container -->
        <LinearLayout
            android:id="@+id/bottomNavTabContainer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tab 1: Home -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home"
                    app:tint="@color/on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="@string/nav_home"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tab 2: Scan with Elevated FAB -->
            <FrameLayout
                android:id="@+id/tabScan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:clickable="true"
                android:focusable="true">

                <!-- Elevated Scan FAB (56dp x 56dp, -24dp top offset) -->
                <FrameLayout
                    android:id="@+id/fabScan"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-24dp"
                    android:background="@drawable/bg_scan_fab"
                    android:elevation="6dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_qr_code_scanner"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="@string/nav_scan"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- Tab 3: My Pass -->
            <LinearLayout
                android:id="@+id/tabMyPass"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_badge"
                    app:tint="@color/on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="@string/nav_my_pass"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tab 4: Profile (ACTIVE) -->
            <LinearLayout
                android:id="@+id/tabProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person_outline"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:text="@string/nav_profile"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Center Progress Loading Bar -->
    <ProgressBar
        android:id="@+id/profileProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

</FrameLayout>
