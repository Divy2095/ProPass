<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container_lowest"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".SplashActivity">

    <!-- Ambient Gradient Orb 1 (Top-Left, soft primary blue) -->
    <View
        android:id="@+id/orbTopLeft"
        android:layout_width="256dp"
        android:layout_height="256dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="-32dp"
        android:layout_marginTop="80dp"
        android:alpha="0.6"
        android:background="@drawable/bg_ambient_orb_top_left" />

    <!-- Ambient Gradient Orb 2 (Bottom-Right, soft light blue) -->
    <View
        android:id="@+id/orbBottomRight"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="-48dp"
        android:layout_marginBottom="60dp"
        android:alpha="0.7"
        android:background="@drawable/bg_ambient_orb_bottom_right" />

    <!-- Center Content Stack (Centered vertically & horizontally, max ~384dp width) -->
    <LinearLayout
        android:id="@+id/centerContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- App Icon Stack (128dp x 128dp with 24dp radius and soft glow) -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Ambient soft blue glow behind the icon -->
            <View
                android:id="@+id/iconGlow"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:alpha="0.7"
                android:background="@drawable/bg_icon_glow" />

            <!-- App Icon Container Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/iconCard"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardMaxElevation="12dp"
                app:cardPreventCornerOverlap="false"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivAppIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_app_icon"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_propass_logo" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Brand Title: ProPass (32sp Bold, ~40sp line height, tight tracking) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:lineHeight="40sp"
            android:text="@string/app_name"
            android:textAlignment="center"
            android:textColor="@color/on_surface"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:targetApi="p" />

        <!-- Tagline: Your professional identity. One pass. (16sp Regular, ~24sp line height) -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:lineHeight="24sp"
            android:text="@string/splash_tagline"
            android:textAlignment="center"
            android:textColor="@color/on_surface_variant"
            android:textSize="16sp"
            tools:targetApi="p" />

    </LinearLayout>

    <!-- Loading Indicator (Pinned ~48dp from bottom, 4dp x 32dp capsule track) -->
    <FrameLayout
        android:id="@+id/loaderContainer"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_loader_track"
        android:clipChildren="true"
        android:clipToPadding="true">

        <!-- Animated Thumb (4dp x 11dp capsule) -->
        <View
            android:id="@+id/loaderThumb"
            android:layout_width="4dp"
            android:layout_height="11dp"
            android:background="@drawable/bg_loader_thumb" />

    </FrameLayout>

</RelativeLayout>
