<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scanQrRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inverse_surface"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ScanQRActivity">

    <!-- 1. Real CameraX PreviewView -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Dark Camera Viewfinder Overlay / Backdrop Layer -->
    <FrameLayout
        android:id="@+id/layoutCameraOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Ambient Office Backdrop Mock (visible as fallback / ambient glow) -->
        <View
            android:id="@+id/viewAmbientMock1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.15"
            android:background="@drawable/bg_ambient_orb_bottom_right" />

        <View
            android:id="@+id/viewAmbientMock2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.15"
            android:background="@drawable/bg_ambient_orb_top_left" />

        <!-- Dark Translucent Overlay Mask -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#40000000" />

    </FrameLayout>

    <!-- 3. Central QR Scanning Reticle Frame (256dp x 256dp) -->
    <FrameLayout
        android:id="@+id/scanReticleFrame"
        android:layout_width="256dp"
        android:layout_height="256dp"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 4 L-Shaped Corner Reticles (32dp x 32dp, stroke 4dp) -->
        <ImageView
            android:id="@+id/cornerTL"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|start"
            android:contentDescription="@null"
            android:src="@drawable/ic_scan_corner_tl" />

        <ImageView
            android:id="@+id/cornerTR"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:src="@drawable/ic_scan_corner_tr" />

        <ImageView
            android:id="@+id/cornerBL"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="@null"
            android:src="@drawable/ic_scan_corner_bl" />

        <ImageView
            android:id="@+id/cornerBR"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@null"
            android:src="@drawable/ic_scan_corner_br" />

        <!-- Laser Scanning Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!-- Animated Laser Scanning Line -->
            <View
                android:id="@+id/viewScannerLaser"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/bg_scanner_laser" />

        </FrameLayout>

    </FrameLayout>

    <!-- 4. Top Floating Guidance Hint Capsule -->
    <LinearLayout
        android:id="@+id/layoutHintCapsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_hint_capsule"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvScanHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxWidth="280dp"
            android:text="@string/scan_hint_align_qr"
            android:textColor="@color/inverse_on_surface"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 5. Bottom Controls Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Flashlight Button (64dp) -->
        <FrameLayout
            android:id="@+id/btnFlashlight"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_camera_control_circle"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivFlashlightIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_flashlight"
                android:src="@drawable/ic_flashlight_on"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Center Shutter Button (80dp) -->
        <FrameLayout
            android:id="@+id/btnShutter"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_shutter_outer_ring"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_scan_fab">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_shutter"
                    android:src="@drawable/ic_qr_code_scanner"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </FrameLayout>

        <!-- Gallery Button (64dp) -->
        <FrameLayout
            android:id="@+id/btnGallery"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_camera_control_circle"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_gallery"
                android:src="@drawable/ic_photo_library"
                app:tint="#FFFFFF" />
        </FrameLayout>

    </LinearLayout>

    <!-- 6. Fixed Translucent Top App Bar -->
    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_translucent_bar"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Button -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/on_surface" />
            </FrameLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/cd_app_icon"
                android:src="@drawable/ic_propass_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:text="@string/scan_screen_title"
                android:textColor="@color/on_surface"
                android:textSize="20sp" />

            <FrameLayout
                android:id="@+id/topBarAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_avatar_circle">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person"
                    app:tint="@color/outline" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
