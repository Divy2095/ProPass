# Application Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (Docker Compose & Prisma)
POSTGRES_USER=propass_user
POSTGRES_PASSWORD=your_local_postgres_password
POSTGRES_DB=propass_db
POSTGRES_PORT=5432

# Prisma Database Connection URL
DATABASE_URL=postgresql://propass_user:your_local_postgres_password@localhost:5432/propass_db?schema=public

# Authentication & JWT Configuration
JWT_SECRET=your_local_jwt_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
