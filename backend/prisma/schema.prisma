datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ATTENDEE
  ORGANIZER
}

enum FormQuestionType {
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  CHECKBOX
}

enum PurposeOfVisit {
  GENERAL_ATTENDEE
  SPEAKER
  SPONSOR_EXHIBITOR
  MEDIA_PRESS
}

enum RegistrationStatus {
  CONFIRMED
  PENDING
  CHECKED_IN
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  googleId      String?        @unique
  role          UserRole       @default(ATTENDEE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  profile       Profile?
  digitalPass   DigitalPass?
  registrations Registration[]
  refreshTokens RefreshToken[]
  organizedEvents Event[]

  @@map("users")
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  fullName        String
  title           String?  // e.g. "Senior UX Researcher"
  organization    String?  // e.g. "TechFlow Inc." / "University of Technology"
  phone           String?  // e.g. "+1 (555) 019-2834"
  linkedinUrl     String?
  avatarUrl       String?
  isVerified      Boolean  @default(false)
  completionScore Int      @default(85)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model DigitalPass {
  id           String    @id @default(uuid())
  userId       String    @unique
  passNumber   String    @unique // e.g. "PP-2024-8849"
  qrPayload    String    // Cryptographically signed pass token or unique identifier
  tier         String    @default("PREMIUM")
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("digital_passes")
}

model Event {
  id             String         @id @default(uuid())
  slug           String         @unique // e.g. "techconf-2024"
  title          String         // e.g. "TechConf 2024"
  overline       String         @default("EVENT REGISTRATION")
  subtitle       String         // e.g. "Complete your registration to secure your spot."
  description    String?
  location       String?
  startDate      DateTime
  endDate        DateTime
  maxDuration    Int            @default(5)
  isActive       Boolean        @default(true)
  date           String?
  startTime      String?
  endTime        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organizerId    String?
  organizer      User?          @relation(fields: [organizerId], references: [id], onDelete: SetNull)

  registrations  Registration[]
  form           RegistrationForm?

  @@map("events")
}

model Registration {
  id             String             @id @default(uuid())
  userId         String
  eventId        String
  fullName       String
  email          String
  institution    String
  purpose        PurposeOfVisit
  durationDays   Int
  vehicleNumber  String?
  status         RegistrationStatus @default(CONFIRMED)
  registeredAt   DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers        RegistrationAnswer[]

  @@unique([userId, eventId])
  @@map("registrations")
}

model RegistrationForm {
  id          String         @id @default(uuid())
  eventId     String         @unique
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  questions   FormQuestion[]

  @@map("registration_forms")
}

model FormQuestion {
  id             String           @id @default(uuid())
  formId         String
  label          String
  type           FormQuestionType @default(SHORT_TEXT)
  isRequired     Boolean          @default(false)
  options        String[]         @default([])
  isDefaultField Boolean          @default(false)
  orderIndex     Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  form           RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers        RegistrationAnswer[]

  @@index([formId, orderIndex])
  @@map("form_questions")
}

model RegistrationAnswer {
  id             String        @id @default(uuid())
  registrationId String
  questionId     String
  value          String
  createdAt      DateTime      @default(now())

  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question       FormQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([registrationId, questionId])
  @@map("registration_answers")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
